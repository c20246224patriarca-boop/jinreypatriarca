---
const projects = [
	{
		number: '01',
		name: 'Grand Stay Hotel',
		category: 'Web Development',
		description: 'A modern hotel check-in experience with elegant UI and responsive design.',
		tags: ['Astro', 'Tailwind', 'UI Design'],
	},
	{
		number: '02',
		name: 'Admin Dashboard',
		category: 'Dashboard UI',
		description: 'A clean dashboard for managing information, statistics, and data.',
		tags: ['UI/UX', 'Dashboard', 'Responsive'],
	},
	{
		number: '03',
		name: 'Creative Portfolio',
		category: 'Personal Project',
		description: 'A personal creative space showcasing designs and web development.',
		tags: ['Design', 'Portfolio', 'Frontend'],
	},
];
---

<section id="projects" class="section-bg bg-[#0d0d12] border-y border-white/5 py-20" data-reveal>
	<div class="max-w-5xl mx-auto px-6">
		<div class="mb-10">
			<p class="text-purple-400 text-xs tracking-[0.2em] uppercase">Selected work</p>
			<h2 class="text-3xl md:text-4xl font-semibold mt-3">Projects</h2>
		</div>

		<div class="grid md:grid-cols-3 gap-4">
			{
				projects.map((project) => (
					<article class="project-card surface bg-[#12121a] rounded-xl border border-white/5 p-6">
						<div class="flex items-center justify-between gap-3">
							<span class="text-xs text-gray-500">{project.number}</span>
							<span class="text-xs text-purple-400">{project.category}</span>
						</div>
						<h3 class="text-lg font-semibold mt-6">{project.name}</h3>
						<p class="muted text-gray-400 text-sm leading-6 mt-3">{project.description}</p>
						<p class="muted text-gray-500 text-xs mt-5">{project.tags.join(' · ')}</p>
					</article>
				))
			}
		</div>
	</div>
</section>
