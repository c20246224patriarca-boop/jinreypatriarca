<section id="contact" class="py-20" data-reveal>
	<div class="max-w-5xl mx-auto px-6">
		<div class="mb-10">
			<p class="text-purple-400 text-xs tracking-[0.2em] uppercase">Contact</p>
			<h2 class="text-3xl md:text-4xl font-semibold mt-3">Let's talk</h2>
			<p class="muted text-gray-400 leading-7 mt-4 max-w-xl">
				Have a project or opportunity in mind? Send me a message.
			</p>
		</div>

		<div class="grid md:grid-cols-2 gap-10">
			<div class="flex flex-col gap-5">
				<a href="mailto:c20246224.patriarca@csav.edu.ph" class="contact-link">
					<span class="muted text-gray-500 text-xs">EMAIL</span>
					<span class="font-medium">c20246224.patriarca@csav.edu.ph</span>
				</a>
				<a href="tel:+639506433438" class="contact-link">
					<span class="muted text-gray-500 text-xs">PHONE</span>
					<span class="font-medium">09506433438</span>
				</a>
			</div>

			<form data-contact-form class="surface bg-[#12121a] border border-white/5 rounded-xl p-6 space-y-4">
				<div>
					<label for="contact-name" class="block mb-2 text-sm text-gray-300">Your Name</label>
					<input
						type="text"
						id="contact-name"
						name="name"
						placeholder="Your Name"
						required
						class="input-bg w-full bg-[#09090d] border border-gray-700 rounded-lg p-3 text-white focus:outline-none focus:border-purple-500"
					/>
				</div>

				<div>
					<label for="contact-email" class="block mb-2 text-sm text-gray-300">Your Email</label>
					<input
						type="email"
						id="contact-email"
						name="email"
						placeholder="Your Email"
						required
						class="input-bg w-full bg-[#09090d] border border-gray-700 rounded-lg p-3 text-white focus:outline-none focus:border-purple-500"
					/>
				</div>

				<div>
					<label for="contact-message" class="block mb-2 text-sm text-gray-300">Your Message</label>
					<textarea
						id="contact-message"
						name="message"
						rows="4"
						placeholder="Your Message"
						required
						class="input-bg w-full bg-[#09090d] border border-gray-700 rounded-lg p-3 text-white resize-none focus:outline-none focus:border-purple-500"
					></textarea>
				</div>

				<button
					type="submit"
					class="w-full bg-purple-600 hover:bg-purple-700 rounded-lg py-3 font-medium text-white transition"
				>
					Send Message
				</button>
				<p class="muted text-gray-500 text-xs">This form is a preview and does not send messages yet.</p>
			</form>
		</div>
	</div>
</section>

<script>
	const contactForm = document.querySelector<HTMLFormElement>('[data-contact-form]');
	contactForm?.addEventListener('submit', (event) => event.preventDefault());
</script>
