<section id="contact" class="py-24" data-reveal>
	<div class="max-w-7xl mx-auto px-6">
		<div class="surface bg-[#12121a] border border-white/5 rounded-3xl p-8 md:p-14 relative overflow-hidden">
			<div class="absolute right-0 top-0 w-72 h-72 bg-purple-600/10 blur-[100px] rounded-full pointer-events-none"></div>

			<div class="grid md:grid-cols-2 gap-10 relative">
				<div>
					<p class="text-purple-400 text-xs tracking-[0.25em] uppercase">Get in touch</p>
					<h2 class="text-4xl md:text-5xl font-bold mt-4 leading-tight">
						Let's create<br />
						<span class="gradient-text">something great.</span>
					</h2>
					<p class="muted text-gray-400 leading-7 mt-6 max-w-md">
						Have an idea, a project, or an opportunity? I'd love to connect, collaborate, and learn
						something new.
					</p>

					<div class="mt-8 flex flex-col gap-4">
						<a
							href="mailto:c20246224.patriarca@csav.edu.ph"
							class="surface border border-white/10 bg-white/[0.03] rounded-xl p-5 hover:border-purple-500/40 transition"
						>
							<p class="muted text-gray-500 text-xs">EMAIL ME</p>
							<p class="font-medium mt-2">↗</p>
						</a>
						<a
							href="tel:"
							class="surface border border-white/10 bg-white/[0.03] rounded-xl p-5 hover:border-purple-500/40 transition"
						>
							<p class="muted text-gray-500 text-xs">CALL OR TEXT</p>
							<p class="font-medium mt-2">↗</p>
						</a>
						<a
							href="https://github.com/"
							target="_blank"
							rel="noreferrer"
							class="surface border border-white/10 bg-white/[0.03] rounded-xl p-5 hover:border-purple-500/40 transition"
						>
							<p class="muted text-gray-500 text-xs">GITHUB</p>
							<p class="font-medium mt-2">Explore my code ↗</p>
						</a>
					</div>
				</div>

				<form
					data-contact-form
					class="surface bg-[#12121a] border border-white/5 rounded-2xl p-8 space-y-5"
				>
					<div>
						<label for="contact-name" class="block mb-2 text-sm text-gray-300">Your Name</label>
						<input
							type="text"
							id="contact-name"
							name="name"
							placeholder="Your Name"
							required
							class="input-bg w-full bg-[#09090d] border border-gray-700 rounded-xl p-4 text-white focus:outline-none focus:border-purple-500"
						/>
					</div>

					<div>
						<label for="contact-email" class="block mb-2 text-sm text-gray-300">Your Email</label>
						<input
							type="email"
							id="contact-email"
							name="email"
							placeholder="Your Email"
							required
							class="input-bg w-full bg-[#09090d] border border-gray-700 rounded-xl p-4 text-white focus:outline-none focus:border-purple-500"
						/>
					</div>

					<div>
						<label for="contact-message" class="block mb-2 text-sm text-gray-300">Your Message</label>
						<textarea
							id="contact-message"
							name="message"
							rows="5"
							placeholder="Your Message"
							required
							class="input-bg w-full bg-[#09090d] border border-gray-700 rounded-xl p-4 text-white resize-none focus:outline-none focus:border-purple-500"
						></textarea>
					</div>

					<button
						type="submit"
						class="w-full bg-purple-600 hover:bg-purple-700 rounded-xl py-4 font-semibold text-white transition"
					>
						Send Message
					</button>

					<p class="muted text-gray-500 text-xs">
						This form is a design preview and does not send messages yet.
					</p>
				</form>
			</div>
		</div>
	</div>
</section>

<script>
	const contactForm = document.querySelector<HTMLFormElement>('[data-contact-form]');
	contactForm?.addEventListener('submit', (event) => event.preventDefault());
</script>
